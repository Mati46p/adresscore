# Supabase (Project Settings -> API). Klucz anon jest publiczny z założenia – chroni RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CEIDG API v3 (dane.biznes.gov.pl), token JWT – tylko ETL, nigdy we froncie (#104)
CEIDG_TOKEN=

# GUS REGON BIR1.1 (api.stat.gov.pl), klucz uzytkownika – tylko ETL (#104)
REGON_BIR_KEY=

# JEV (TypeSafe, api.typesafe.ai) – tylko funkcja api/jev, nigdy we froncie (#15)
JEV_API_KEY=

# Pomiar ruchu i panel admina (#206) – tylko funkcja api/zdarzenie (Vercel albo serwer Node na Coolify)
# i middleware `pnpm dev`. NIGDY z prefiksem VITE_: klucz serwisowy nie może trafić do przeglądarki.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Hosty serwisu po przecinku (sprawdzany Origin żądań pomiaru), np. adresscore.pl,www.adresscore.pl
ADRESSCORE_HOSTY=
