{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": false },
  "functions": { "api/seo.js": { "includeFiles": "api/_seo-index.json.gz" } },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ],
  "rewrites": [
    { "source": "/adres/:slug", "destination": "/api/seo?view=adres&slug=:slug" },
    { "source": "/katalog/ulice", "destination": "/api/seo?view=katalog" },
    { "source": "/katalog/:slug", "destination": "/api/seo?view=ulica&slug=:slug" },
    { "source": "/katalog", "destination": "/api/seo?view=katalog" },
    { "source": "/metoda", "destination": "/api/seo?view=metoda" },
    {
      "source": "/((?!assets/|api/|dane/|mapa/|sitemap|robots\\.txt|llms\\.txt|sw\\.js|seo-boot\\.js).+)",
      "destination": "/api/seo?view=404"
    }
  ]
}
